# Database Configs
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password
POSTGRES_DB=hiregen_db
POSTGRES_HOST=your_supabase_host
POSTGRES_PORT=5432

SECRET_KEY=your_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Admin User
ADMIN_EMAIL=admin@hiregen.com
ADMIN_PASSWORD=your_admin_password

# Cloudinary Configs (thay MinIO)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Gemini API
GEMINI_API_KEY=your_gemini_api_key
RUN_BASELINE_PIPELINE=True

# Redis
REDIS_URL=redis://default:password@your-upstash-host:port

# ChromaDB
CHROMA_HOST=hiregen-chromadb.onrender.com
CHROMA_PORT=8000
